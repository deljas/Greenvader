+	for y: int in a.get_height():
+		for x: int in a.get_width():
+			if Geometry2D.is_point_in_polygon(Vector2(x+0.5,y+0.5),polygon) and a.get_pixel(x,y)!=b.get_pixel(x,y):
+				count += 1
+	return count
+
