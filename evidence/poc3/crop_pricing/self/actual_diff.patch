   if e.size!=Vector2i(catalog[e.kind].size[0],catalog[e.kind].size[1]) or not Rect2i(0,0,224,224).encloses(Rect2i(e.cell,e.size)): return false
   if e.hp<=0.0 or e.hp>e.max_hp: return false
